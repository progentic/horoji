{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horoji.org/json/bounded-change-contract.schema.json",
  "title": "Bounded Change Contract",
  "description": "Executable definition of the scope, constraints, gates, and review evidence required before a generated candidate may advance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "intent",
    "scope",
    "allowed_surfaces",
    "forbidden_surfaces",
    "input_output_schema_refs",
    "acceptance_criteria",
    "quality_gates",
    "evidence_requirements",
    "review_boundary",
    "rollback_requirements"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "business_context", "risk_context"],
      "properties": {
        "summary": { "type": "string", "minLength": 10 },
        "business_context": { "type": "string", "minLength": 1 },
        "risk_context": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_type", "repository", "target_paths"],
      "properties": {
        "change_type": {
          "type": "string",
          "enum": ["feature", "bugfix", "refactor", "security", "test", "docs", "harness"]
        },
        "repository": { "type": "string", "minLength": 1 },
        "target_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowed_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_surfaces": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "input_output_schema_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{3}$" },
          "statement": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "schema_validation",
          "cargo_fmt",
          "clippy",
          "cargo_build",
          "cargo_deny",
          "cargo_test",
          "property_tests",
          "mutation_tests",
          "sandbox_execution",
          "evidence_capture",
          "human_review"
        ]
      },
      "uniqueItems": true
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "evidence-record.schema.json#/$defs/evidence_kind" },
      "uniqueItems": true
    },
    "review_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_review_required", "review_focus"],
      "properties": {
        "human_review_required": { "type": "boolean", "const": true },
        "review_focus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["semantic_fit", "risk_acceptance", "architecture", "security", "maintainability", "business_value"]
          },
          "uniqueItems": true
        }
      }
    },
    "rollback_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "strategy"],
      "properties": {
        "required": { "type": "boolean" },
        "strategy": { "type": "string", "minLength": 1 }
      }
    }
  }
}
