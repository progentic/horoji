{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horoji.org/json/evidence-record.schema.json",
  "title": "Evidence Record",
  "description": "Structured proof record showing which gates a candidate passed, failed, or skipped with justification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "candidate_id",
    "contract_id",
    "created_at",
    "overall_status",
    "gate_results",
    "review_status",
    "replay"
  ],
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^evidence-[a-z0-9._-]+$" },
    "candidate_id": { "type": "string", "pattern": "^candidate-[a-z0-9._-]+$" },
    "contract_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "overall_status": { "type": "string", "enum": ["admissible", "non_admissible", "review_required"] },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate_result" }
    },
    "review_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "type": "string", "enum": ["not_required", "pending", "approved", "rejected"] },
        "reviewer": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replayable", "inputs_hash", "environment_hash"],
      "properties": {
        "replayable": { "type": "boolean" },
        "inputs_hash": { "type": "string", "minLength": 8 },
        "environment_hash": { "type": "string", "minLength": 8 }
      }
    }
  },
  "$defs": {
    "evidence_kind": {
      "type": "string",
      "enum": [
        "schema_validation",
        "type_check",
        "format_check",
        "static_analysis",
        "build",
        "dependency_policy",
        "unit_tests",
        "integration_tests",
        "property_tests",
        "mutation_tests",
        "sandbox_logs",
        "security_scan",
        "architecture_policy",
        "coverage",
        "rollback_safety",
        "human_review",
        "deployment_gate",
        "runtime_telemetry"
      ]
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "summary"],
      "properties": {
        "gate": { "$ref": "#/$defs/evidence_kind" },
        "status": { "type": "string", "enum": ["passed", "failed", "skipped", "not_applicable"] },
        "summary": { "type": "string", "minLength": 1 },
        "artifact_ref": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
